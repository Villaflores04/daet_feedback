# Required for shared feedback across browsers and devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended for the server route. Keep this secret server-side; never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Private municipal-desk sign-in password. Set this only in the hosting environment.
ADMIN_DESK_KEY=
