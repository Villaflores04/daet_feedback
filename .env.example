# Required for shared feedback across browsers and devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended for the server route. Keep this secret server-side; never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Private municipal-desk sign-in password. Set this only in the hosting environment.
ADMIN_DESK_KEY=

# Optional navigation back to the faculty-owned dashboard (HTTPS URL).
# Navigation does not establish a shared login or enable rewards.
NEXT_PUBLIC_DAET_CONNECT_URL=

# true only when mounted inside the central application's existing shell.
NEXT_PUBLIC_FEEDBACK_SHARED_SHELL=false
