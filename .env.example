# Required for shared feedback across browsers and devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended for the server route. Keep this secret server-side; never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for the existing admin sign-in password; no per-action key.
# If unset, the existing "daet" desk password remains in use. Never use NEXT_PUBLIC_.
ADMIN_DESK_KEY=
